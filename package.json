{
  "name": "connectapp",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "tokens": "pnpm --filter @connectapp/ui run tokens",
    "catalogue": "node scripts/build-client-catalogue.mjs",
    "fonts": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "db:generate": "pnpm --filter @connectapp/db run generate",
    "db:migrate": "pnpm --filter @connectapp/db run migrate",
    "db:seed": "pnpm --filter @connectapp/db run seed",
    "test": "turbo run test",
    "db:seed:users": "pnpm --filter @connectapp/db run seed:users",
    "ship": "node scripts/ship.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^15.5.27",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "playwright": "^1.64.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "postcss": "^8.5.23",
      "source-map-js": "^1.2.2"
    }
  }
}
