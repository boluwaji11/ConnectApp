# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
# A route called build is source, not output. Git cannot re-include a file
# whose parent directory is excluded, so the directory itself is un-excluded
# here. Without this the whole of apps/web/app/reports/build was silently
# never committed.
!apps/web/app/**/build/
.next/
.next-verify/
.next-dev-verify/
.next-turbo/
.next-ci/
/apps/web/.next-perf/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Testing and coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# Local database and uploads
*.sqlite
*.sqlite3
*.db
/tmp/

# Scratch scripts a session writes beside the code it is driving. They are
# throwaway, and one of them reached a commit before this rule existed.
*.tmp.mjs
*.tmp.cjs
*.tmp.js
/uploads/

# Electron build output (Phase 2)
apps/stage/release/
apps/stage/out/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local agent instructions, not part of the public repo
CLAUDE.md

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Regenerated by next dev and next build, and its contents follow distDir.
next-env.d.ts

# Hearth Stage lives in its own repository, in this folder.
/Stage/

# Vercel
.vercel

# The security review's working notes. Traced paths and payloads, for the
# maintainers. docs/security-audit.md is the public record.
security-audit-private.md

# Rendered by packages/mail/scripts/preview.mjs, for looking at.
email-previews/

# Outreach to churches. Draft letters, real contact details and a record of what
# was sent, which is correspondence rather than code and does not belong in a
# public repository.
scripts/outreach/

# Personal permission rules, not shared
.claude/settings.local.json
